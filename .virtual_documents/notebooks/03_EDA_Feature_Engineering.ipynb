# cadrer sur les lat et long de la France métropolitaine
df_france_metro = df_eda[
    df_eda['lat'].between(41, 52) &
    df_eda['long'].between(-6, 10)
]


plt.figure(figsize=(4,4))
plt.scatter(
    df_france_metro['long'],
    df_france_metro['lat'],
    s=1,
    alpha=0.3
)

plt.title("Carte des accidents - France métropolitaine")
plt.xlabel("Longitude")
plt.ylabel("Latitude")
plt.show()











pd.crosstab(df_eda["acc_est_en_agglo"], df_eda["target_grav"], normalize="index")








features = [
    "acc_est_en_agglo",
    "intersection",
    "luminosite",
    "cond_atmo",
    "vitesse_max_auto",
    "nbre_voies_circu"
]


df_tmp = df_eda[features + ["target_grav"]].dropna()


X = df_tmp[features]


y = df_tmp["target_grav"]


rf = RandomForestClassifier(n_estimators=100, random_state=42)


rf.fit(X, y)


importances = pd.Series(rf.feature_importances_, index=features).sort_values(ascending=False)


importances



